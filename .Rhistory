# Parameters
initial_investment <- 10000
interest_rate <- 0.10
years <- 0:60
# Compound growth calculation
value <- initial_investment * (1 + interest_rate)^years
# Create barplot
barplot(
value,
names.arg = years,
col = "steelblue",
border = NA,
main = "Growth of $10,000 at 10% Annual Interest",
xlab = "Year",
ylab = "Investment Value ($)",
las = 2,
cex.names = 0.7
)
# Optional: add grid lines
grid(nx = NA, ny = NULL)
quarto::quarto_render()
here::here()
quarto::quarto_render()
